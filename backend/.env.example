# TiggoMate Backend Configuration
PORT=8080

# 1. AI Assistant Provider (OpenRouter / OpenAI)
# Client application NEVER holds this key.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 2. CarLinko Home Assistant Bridge (Post-1,000km Activation)
# Used to query ha-carlinko custom integration (https://github.com/thititongumpun/ha-carlinko)
# Client application NEVER holds this Long-Lived Access Token.
HA_BASE_URL=http://your-homeassistant-ip:8123
HA_ACCESS_TOKEN=your_home_assistant_long_lived_access_token_here
